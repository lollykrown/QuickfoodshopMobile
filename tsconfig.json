{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    "app/**/*.jsx",
    "components/**/*.js",
    "components/**/*.jsx",
    "constants/**/*.js",
    "contexts/**/*.js",
    "hooks/**/*.js",
    "lib/**/*.js",
    "services/**/*.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "lib/axios.js"
  ]
}
